---
const textos = [
  {
    titulo: "Título ejemplo",
    resumen: "Subtítulo ejemplo de texto que iría en esta tarjeta, sirviendo como referencia visual.",
    fecha: "5 Abril 2026",
    slug: "ejemplo-1",
  },
  {
    titulo: "Título ejemplo",
    resumen: "Subtítulo ejemplo de texto que iría en esta tarjeta, sirviendo como referencia visual.",
    fecha: "5 Abril 2026",
    slug: "ejemplo-2",
  },
  {
    titulo: "Título ejemplo",
    resumen: "Subtítulo ejemplo de texto que iría en esta tarjeta, sirviendo como referencia visual.",
    fecha: "5 Abril 2026",
    slug: "ejemplo-3",
  },
];
---
<section class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-3xl font-bold mb-6 text-base-900">Textos</h2>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    {textos.map((texto) => (
      <article class="border border-base-200 rounded-xl p-5 flex flex-col">
        <h3 class="text-lg font-semibold text-base-900">{texto.titulo}</h3>
        <p class="text-sm text-base-500 mt-2 line-clamp-3 flex-grow">{texto.resumen}</p>
        <div class="flex justify-between items-center mt-4 text-sm">
          <span class="text-base-400">{texto.fecha}</span>
          <a href={`/posts/${texto.slug}`} class="text-base-900 hover:underline">Leer más →</a>
        </div>
      </article>
    ))}
  </div>

  <div class="text-center mt-8">
    <a href="/archivo" class="text-sm text-base-600 hover:underline">Ver todos →</a>
  </div>
</section>
