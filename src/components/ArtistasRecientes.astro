---
// Datos de ejemplo. Luego los podés traer de una colección de contenido
const artistas = [
  { nombre: "Brume Poletti", slug: "brume-poletti" },
  { nombre: "Flor Oviedo", slug: "flor-oviedo" },
  { nombre: "Ceci ", slug: "ceci" },
  { nombre: "Gio armoa", slug: "Gio-Armoa" }
];
---
<section class="max-w-7xl mx-auto px-4 py-16">
  <div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold text-base-900">Artistas recientes</h2>
    <a href="/artistas" class="text-sm text-base-600 hover:underline">Ver todos →</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {artistas.map(artista => (
      <a href={`/artistas/${artista.slug}`} class="group block bg-base-100 rounded-xl p-6 text-center hover:shadow-md transition border border-base-200">
        <div class="w-32 h-32 mx-auto bg-base-200 rounded-full mb-4"></div>
        <h3 class="font-semibold text-xl text-base-900">{artista.nombre}</h3>
        <p class="text-sm text-base-500 mt-1 group-hover:text-base-700">Ver obras →</p>
      </a>
    ))}
  </div>
</section>
