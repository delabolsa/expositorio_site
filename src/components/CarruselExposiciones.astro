---
const exposiciones = [
  { 
    titulo: "Combatir el miedo", 
    lugar: "Sala Cubo", 
    fecha: "24 Sep 2026", 
    link: "exposiciones/exposcioncombatirelmiedo", 
    imagen: "/exposiciones/exposcioncombatirelmiedo.png" 
  },
];
---

<section class="max-w-7xl mx-auto px-4 py-16">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-3xl font-bold text-base-900">Exposiciones</h2>
    <a href="/exposiciones" class="text-sm text-base-600 hover:underline">Ver más info →</a>
  </div>

  <div
    x-data={`{
      current: 0,
      total: ${exposiciones.length},
      timer: null,
      start() {
        this.timer = setInterval(() => {
          this.current = (this.current + 1) % this.total;
        }, 5000);
      },
      goTo(i) {
        this.current = i;
        clearInterval(this.timer);
        this.start();
      }
    }`}
    x-init="start()"
    class="relative w-full"
  >
    <div class="overflow-hidden rounded-xl w-full">
      <div
        class="flex transition-transform duration-700 ease-out"
        x-bind:style="`transform: translateX(-${current * 100}%)`"
      >
        {exposiciones.map((expo) => (
          <div class="min-w-full flex-shrink-0">
            <a href={expo.link} class="block group">
              {expo.imagen ? (
                <img
                  src={expo.imagen}
                  alt={expo.titulo}
                  class="w-full h-auto object-contain rounded-xl"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-64 md:h-96 bg-base-200 rounded-xl"></div>
              )}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Indicadores -->
    <div class="flex justify-center gap-2 mt-4">
      {exposiciones.map((_, i) => (
        <button
          type="button"
          aria-label={`Ir a la exposición ${i + 1}`}
          x-on:click={`goTo(${i})`}
          class="w-2.5 h-2.5 rounded-full transition-colors"
          x-bind:class={`current === ${i} ? 'bg-base-900' : 'bg-base-300'`}
        ></button>
      ))}
    </div>
  </div>
</section>
