---
const exposiciones = [
  { titulo: "Contratá el asfalto", lugar: "Galería X", fecha: "10-20 May 2025", link: "/exposiciones/contrata-el-asfalto" },
  { titulo: "Otra muestra", lugar: "Espacio Y", fecha: "1-15 Jun 2025", link: "/exposiciones/otra-muestra" },
  { titulo: "Tercera exposición", lugar: "Museo Z", fecha: "Julio 2025", link: "/exposiciones/tercera-exposicion" },
];
---
<section class="max-w-7xl mx-auto px-4 py-16">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-3xl font-bold text-base-900">Exposiciones</h2>
    <a href="/exposiciones" class="text-sm text-base-600 hover:underline">Ver más info →</a>
  </div>

  <div x-data="{ current: 0 }" class="relative">
    <div class="overflow-hidden rounded-xl">
      <div
        class="flex transition-transform duration-500 ease-out"
        x-bind:style="`transform: translateX(-${current * 100}%)`"
      >
        {exposiciones.map((expo) => (
          <div class="w-full flex-shrink-0">
            <a href={expo.link} class="block group">
              <div class="h-64 md:h-96 bg-base-200 rounded-xl"></div>
            </a>
          </div>
        ))}
      </div>
    </div>

    <div class="flex justify-center gap-2 mt-4">
      {exposiciones.map((_, i) => (
        <button
          type="button"
          aria-label={`Ir a la exposición ${i + 1}`}
          onclick={`current = ${i}`}
          class="w-2.5 h-2.5 rounded-full transition-colors"
          x-bind:class={`current === ${i} ? 'bg-base-900' : 'bg-base-300'`}
        ></button>
      ))}
    </div>
  </div>
</section>
