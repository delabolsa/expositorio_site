---
const { textos = [] } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-3xl font-bold mb-6 text-base-900">Textos</h2>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    {textos.map((texto) => (
      <article class="border border-base-200 rounded-xl p-5 flex flex-col">

        <h3 class="text-lg font-semibold text-base-900">
          {texto.data.title}
        </h3>

        <p class="text-sm text-base-500 mt-2 line-clamp-3 flex-grow">
          {texto.data.description}
        </p>

        <div class="flex justify-between items-center mt-4 text-sm">
          <span class="text-base-400">
            {texto.data.pubDate.toLocaleDateString("es-PY", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </span>

          <a
            href={`/textos/${texto.id}`}
            class="text-base-900 hover:underline"
          >
            Leer más →
          </a>
        </div>

      </article>
    ))}
  </div>

  <div class="text-center mt-8">
    <a
      href="/textos"
      class="text-sm text-base-600 hover:underline"
    >
      Ver todos →
    </a>
  </div>
</section>
