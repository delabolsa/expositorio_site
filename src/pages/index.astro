---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutProject from "@/components/AboutProject.astro";
import VideoEntrevista from "@/components/VideoEntrevista.astro";
import ArtistasRecientes from "@/components/ArtistasRecientes.astro";
import CarruselExposiciones from "@/components/CarruselExposiciones.astro";
import TextosRecientes from "@/components/TextosRecientes.astro";
import ArchivoColectivo from "@/components/ArchivoColectivo.astro";
import Sumate from "@/components/Sumate.astro";
import artistasData from "../data/artistas.json";

// Ordenar por fechaAgregado (más reciente primero)
const artistasConFecha = artistasData.filter(a => a.data.fechaAgregado);
const artistasRecientes = artistasConFecha
  .sort((a,b) => new Date(b.data.fechaAgregado) - new Date(a.data.fechaAgregado))
  .slice(0,4);
---

<BaseLayout title="Expositorio Voyeur - Archivo curatorial independiente">
  <div class="text-base-950 flex flex-col items-center text-center">
    <!-- Hero original (sin cambios) -->
    <section class="w-full h-[800px] bg-[#ffffff] relative flex flex-col items-center justify-center">
      <div class="text-center">
        <h1 class="text-4xl font-regular leading-tight text-black">
          Observaciones sobre artistas <br />
          contemporáneos
          <span class="bg-yellow-300 px-2">emergentes*</span>
        </h1>
      </div>
      <a href="https://expiatoriovoyeur.com/nota-de-intencion" class="absolute bottom-20 flex flex-col items-center text-black hover:opacity-70 transition">
        <span class="w-4 h-4 rounded-full bg-[#c10043] mb-4"></span>
        <span class="text-sm">Lee la nota de intención.</span>
      </a>
    </section>

    <AboutProject />
    <VideoEntrevista />

    {artistasRecientes.length > 0 ? (
      <ArtistasRecientes artistas={artistasRecientes} />
    ) : (
      <div class="max-w-7xl mx-auto px-4 py-16 text-center">
        <h2 class="text-3xl font-bold text-base-900">Artistas recientes</h2>
        <p class="text-base-500 mt-4">Próximamente artistas cargados.</p>
      </div>
    )}

    <CarruselExposiciones />
    <TextosRecientes />
    <ArchivoColectivo />
    <Sumate />
  </div>
</BaseLayout>
