---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const textos = posts
  .filter((post) => post.data.categoria === "texto")
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() -
      new Date(a.data.pubDate).getTime()
  );
---

<BlogLayout>
  <main class="w-full px-4 py-20">
    <div class="max-w-5xl mx-auto">

      <h1 class="text-4xl font-bold mb-12">
        Textos
      </h1>

      <div>
        {textos.map((post) => (
          <article class="border-t border-base-300 py-8">
            <a href={`/blog/post/${post.id}/`} class="block">
              <p class="text-sm mb-2">
                {post.data.pubDate.toLocaleDateString("es-PY")}
              </p>

              <h2 class="text-2xl font-bold">
                {post.data.title}
              </h2>

              <p class="mt-3">
                {post.data.description}
              </p>

              <p class="mt-4 text-sm">
                {post.data.author}
              </p>
            </a>
          </article>
        ))}
      </div>

    </div>
  </main>
</BlogLayout>
