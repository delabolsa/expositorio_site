---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const textos = posts
  .filter((post) => post.data.categoria === "texto")
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() -
      new Date(a.data.pubDate).getTime()
  );
---

<BaseLayout title="Textos - Expiatorio Voyeur">
  <main class="w-full px-4 py-20">
    <div class="max-w-5xl mx-auto">

      <header class="mb-16">
        <h1 class="text-4xl font-bold text-base-950">
          Textos
        </h1>

        <p class="mt-4 text-base-600">
          Escritos, ensayos y textos sobre arte contemporáneo.
        </p>
      </header>

      <div class="flex flex-col">
        {textos.map((post) => (
          <article class="border-t border-base-300 py-8">
            <a href={`/blog/post/${post.id}/`} class="block group">
              
              <p class="text-sm text-base-500 mb-2">
                {post.data.pubDate.toLocaleDateString("es-PY", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>

              <h2 class="text-2xl font-bold text-base-950 group-hover:opacity-60 transition">
                {post.data.title}
              </h2>

              <p class="mt-3 text-base-600">
                {post.data.description}
              </p>

            </a>
          </article>
        ))}
      </div>

    </div>
  </main>
</BaseLayout>
