---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<main>
  <h1>Blog Posts</h1>
  <p>Todos los artículos publicados</p>

  <div class="posts-grid">
    {sortedPosts.map((post) => (
      <article class="post-card">
        <img src={post.data.image.url} alt={post.data.image.alt} />
        <div class="post-content">
          <h2>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </h2>
          <p class="date">{new Date(post.data.pubDate).toLocaleDateString()}</p>
          <p class="description">{post.data.description}</p>
          <p class="author">Por: {post.data.author}</p>
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <a href={`/posts/${post.id}`} class="read-more">Leer más →</a>
        </div>
      </article>
    ))}
  </div>
</main>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .post-card {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .post-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-content h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
  }

  .post-content h2 a {
    color: inherit;
    text-decoration: none;
  }

  .post-content h2 a:hover {
    color: #0066cc;
  }

  .date {
    color: #666;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }

  .description {
    margin: 1rem 0;
    color: #333;
    line-height: 1.5;
  }

  .author {
    font-size: 0.9rem;
    color: #666;
    margin: 0.5rem 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0;
  }

  .tag {
    background: #f0f0f0;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }

  .read-more {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>
