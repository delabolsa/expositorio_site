---
import BaseLayout from "@/layouts/BaseLayout.astro";

// ============================================================
// DATOS DEL ARTISTA – Florencia Oviedo Samudio (Flor)
// ============================================================
const artista = {
  slug: "florencia-oviedo-samudio",
  foto: "/artistas/flor-oviedo-samudio.jpeg",  // DEJAR VACÍO HASTA SUBIR FOTO

  // Palabras clave
  palabrasClave: "investigación, misticismo, artes, pintura, fotografía, instalación, identidad, sociopolítico, intimidades, testimonios colectivos",

  // Contacto profesional
  email: "florovedosamudio@gmail.com",
  instagram: "flonadamas",
  behance: "",
  linkedin: "",
  web: "",

  // Datos básicos
  nombreCompleto: "Florencia Oviedo Samudio",
  nombreArtistico: "Flor",  // o dejar "" si no usa nombre artístico
  colectivo: "Disenso colectivo",
  fechaNacimiento: "12/04/2002",
  lugarNacimiento: "Fernando de la Mora, Paraguay",
  nacionalidad: "Paraguaya",
  residenciaActual: "Villa Elisa, Paraguay",

  // Biografía y declaración artística
  resumenBiografico: `Florencia Oviedo Samudio estudia en el Instituto Superior de Arte (ISA) – Universidad Nacional de Asunción, cursando actualmente el octavo semestre. Forma parte del colectivo Disenso. Ha participado en la exposición "Contra el asfalto liso" en 2026 junto al colectivo. Realizó una residencia poética en Ruido Visual (2025). Escribe poesía y es miembro de la edición de Ruido Visual 2026. Tiene obras en CUATRA (Centro de Artes Visuales).`,

  declaracionArtistica: `Su obra aborda cuestiones sobre la construcción de la identidad individual y colectiva, atravesada por intimidades y testimonios colectivos referentes al misticismo y su relación con las condiciones materiales. El interés por el misticismo viene alimentado por la aproximación a lo espiritual desde su eje político. Flor experimenta con distintos medios como la fotografía, la pintura, la intervención de objetos y la instalación.`,

  otrosProyectos: "Escribe poesía. Miembro de edición de Ruido Visual 2026.",

  formacion: [
    "En curso: Artes Visuales, Instituto Superior de Arte (ISA) – Universidad Nacional de Asunción (UNA). 8vo semestre.",
    "2025: Residencia poética en Ruido Visual."
  ],

  exposicionesIndividuales: [],  // No se mencionan
  exposicionesColectivas: [
    "2026 – 'Contra el asfalto liso' (con el colectivo Disenso) – Lugar no especificado."
  ],
  feriasArte: [],  // No se mencionan

  premios: [],  // No se mencionan

  publicacionesPrensa: "",  // Sin información

  entrevistaDisponible: false,  // No se indica, se deja false por defecto

  espacioAnuncio: "",  // Sin proyectos activos por ahora

  experienciaExtra: [
    "Miembro de edición de Ruido Visual (2026).",
    "Tiene obras en CUATRA (Centro de Artes Visuales)."
  ]
};

// Obras – sin información; dejar array vacío
const obrasArtista = [];

const seriesColecciones = [];
const catalogoDescargable = "";
---

<BaseLayout title={`${artista.nombreCompleto} - Expositorio Voyeur`}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Columna izquierda -->
      <div>
        {artista.foto && (
          <img src={artista.foto} alt={artista.nombreCompleto} class="w-full rounded-xl shadow" />
        )}
        
        <div class="mt-6 bg-[#B70538] text-white rounded-xl shadow-md p-5 space-y-3 text-sm">
          <h3 class="font-bold text-base uppercase tracking-wide border-b border-white/30 pb-1 mb-2">Contacto y datos</h3>
          
          <p><span class="font-semibold">Nacimiento</span> {artista.fechaNacimiento}</p>
          <p><span class="font-semibold">Lugar</span> {artista.lugarNacimiento}</p>
          <p><span class="font-semibold">Residencia</span> {artista.residenciaActual}</p>
          <p><span class="font-semibold">Nacionalidad</span> {artista.nacionalidad}</p>
          <hr class="border-white/20 my-2" />
          <p><span class="font-semibold">Email</span> <a href={`mailto:${artista.email}`} class="underline hover:text-gray-200 break-all">{artista.email}</a></p>
          <p><span class="font-semibold">Instagram</span> <a href={`https://instagram.com/${artista.instagram.replace('@','')}`} target="_blank" class="underline hover:text-gray-200">@{artista.instagram}</a></p>
          {artista.behance && <p><span class="font-semibold">Behance</span> <a href={artista.behance} target="_blank" class="underline">Ver perfil</a></p>}
          {artista.linkedin && <p><span class="font-semibold">LinkedIn</span> <a href={artista.linkedin} target="_blank" class="underline">Perfil</a></p>}
          {artista.web && <p><span class="font-semibold">Web</span> <a href={artista.web} target="_blank" class="underline">{artista.web}</a></p>}
        </div>

        {artista.entrevistaDisponible && (
          <div class="mt-4 text-center">
            <span class="bg-white text-[#B70538] text-xs font-bold px-3 py-1 rounded-full border border-[#B70538] shadow-sm">🎥 Entrevista en video proximamente</span>
          </div>
        )}
      </div>

      <!-- Columna derecha -->
      <div class="md:col-span-2">
        <h1 class="text-4xl font-bold">{artista.nombreCompleto}</h1>
        {artista.nombreArtistico && <p class="text-lg text-base-500">Nombre artístico: {artista.nombreArtistico}</p>}
        {artista.colectivo && <p class="text-sm text-base-500">Colectivo: {artista.colectivo}</p>}

        <div class="mt-4 flex flex-wrap gap-2">
          {artista.palabrasClave.split(',').map(p => (
            <span class="bg-base-200 text-base-700 text-xs px-2 py-1 rounded-full">{p.trim()}</span>
          ))}
        </div>

        <h2 class="text-2xl font-semibold mt-8">Resumen biográfico</h2>
        <div class="prose max-w-none mt-2" set:html={artista.resumenBiografico.replace(/\n/g, '<br/>')} />

        <h2 class="text-2xl font-semibold mt-6">Declaración artística</h2>
        <div class="prose max-w-none mt-2" set:html={artista.declaracionArtistica.replace(/\n/g, '<br/>')} />

        {artista.otrosProyectos && (
          <>
            <h2 class="text-2xl font-semibold mt-6">Otros proyectos</h2>
            <div class="prose max-w-none mt-2" set:html={artista.otrosProyectos.replace(/\n/g, '<br/>')} />
          </>
        )}

        <h2 class="text-2xl font-semibold mt-6">Formación</h2>
        <ul class="list-disc list-inside space-y-1 mt-2">
          {artista.formacion.map(item => <li>{item}</li>)}
        </ul>

        <h2 class="text-2xl font-semibold mt-6">Exposiciones</h2>
        {artista.exposicionesIndividuales.length > 0 && (
          <>
            <h3 class="text-xl font-medium mt-2">Individuales</h3>
            <ul class="list-disc list-inside space-y-1">
              {artista.exposicionesIndividuales.map(item => <li>{item}</li>)}
            </ul>
          </>
        )}
        {artista.exposicionesColectivas.length > 0 && (
          <>
            <h3 class="text-xl font-medium mt-2">Colectivas</h3>
            <ul class="list-disc list-inside space-y-1">
              {artista.exposicionesColectivas.map(item => <li>{item}</li>)}
            </ul>
          </>
        )}
        {artista.feriasArte.length > 0 && (
          <>
            <h3 class="text-xl font-medium mt-2">Ferias de arte</h3>
            <ul class="list-disc list-inside space-y-1">
              {artista.feriasArte.map(item => <li>{item}</li>)}
            </ul>
          </>
        )}

        {artista.premios.length > 0 && (
          <>
            <h2 class="text-2xl font-semibold mt-6">Premios, selecciones y menciones</h2>
            <ul class="list-disc list-inside space-y-1">
              {artista.premios.map(item => <li>{item}</li>)}
            </ul>
          </>
        )}

        {artista.experienciaExtra.length > 0 && (
          <>
            <h2 class="text-2xl font-semibold mt-6">Experiencia profesional / formativa extra</h2>
            <ul class="list-disc list-inside space-y-1">
              {artista.experienciaExtra.map(item => <li>{item}</li>)}
            </ul>
          </>
        )}

        <h2 class="text-2xl font-semibold mt-6">Publicaciones y prensa</h2>
        <p class="mt-2">{artista.publicacionesPrensa || "Sin información por el momento."}</p>

        <h2 class="text-2xl font-semibold mt-8">Proyectos activos y próximas exposiciones</h2>
        <div class="prose max-w-none mt-2" set:html={(artista.espacioAnuncio || "Por actualizar.").replace(/\n/g, '<br/>')} />

        <h2 class="text-2xl font-semibold mt-10 mb-4">Obras</h2>
        <div class="space-y-6">
          {obrasArtista.length === 0 ? (
            <p class="text-base-500">Próximamente se mostrarán las obras.</p>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {obrasArtista.map(obra => (
                <div class="border rounded-lg p-4 hover:shadow transition">
                  {obra.data.imagen && <img src={obra.data.imagen} class="w-full h-48 object-cover rounded mb-3" />}
                  <h3 class="font-bold text-lg">{obra.data.titulo}</h3>
                  <p class="text-sm text-base-500">{obra.data.ano} · {obra.data.tecnica}</p>
                  {obra.data.dimensiones && <p class="text-xs text-base-400">{obra.data.dimensiones}</p>}
                  {obra.data.descripcion && <p class="text-sm mt-2">{obra.data.descripcion}</p>}
                  {obra.data.destacada && <span class="inline-block mt-2 text-xs bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded-full">Destacada</span>}
                </div>
              ))}
            </div>
          )}
          {seriesColecciones.length > 0 && (
            <>
              <h3 class="text-xl font-semibold mt-6">Series o colecciones principales</h3>
              <ul class="list-disc list-inside">
                {seriesColecciones.map(s => <li>{s}</li>)}
              </ul>
            </>
          )}
          {catalogoDescargable && (
            <div class="mt-4">
              <a href={catalogoDescargable} download class="inline-block bg-[#B70538] text-white px-4 py-2 rounded hover:bg-[#8f042b] transition">
                Descargar portafolio / catálogo
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

