---
import BaseLayout from "@/layouts/BaseLayout.astro";
import artistasData from "../../data/artistas.json";

export async function getStaticPaths() {
  return artistasData.map(artista => ({
    params: { slug: artista.slug },
    props: { artista },
  }));
}

const { artista } = Astro.props;
---

<BaseLayout title="Prueba">
  <div class="p-10">
    <h1>Artista recibido: {artista ? artista.data.nombre : 'ninguno'}</h1>
  </div>
</BaseLayout>
