---
import BaseLayout from "@/layouts/BaseLayout.astro";
import artistasData from "../../data/artistas.json";

export async function getStaticPaths() {
  return artistasData.map(artista => ({
    params: { slug: artista.slug },
    props: { artista },
  }));
}

const { artista } = Astro.props;
---

<BaseLayout title="Prueba">
  <div class="p-10">
    <h1>Artista: {artista?.data?.nombre || 'No encontrado'}</h1>
    <p>Slug: {artista?.slug}</p>
  </div>
</BaseLayout>
