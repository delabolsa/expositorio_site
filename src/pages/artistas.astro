---
import BaseLayout from "@/layouts/BaseLayout.astro";

// Datos estáticos; luego conéctalo a una colección
const artistas = [
  "Brume Poletti", "Flor Oviedo", "Ceci Barnis", "Galo Mola", 
  "Ale Facade", "Lucas Vega", "Más nombres..."
];
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-10 text-base-900">Artistas</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {artistas.map(nombre => (
        <div class="bg-base-100 rounded-xl p-6 text-center border border-base-200">
          <div class="w-32 h-32 bg-base-200 rounded-full mx-auto mb-4"></div>
          <h3 class="text-xl font-semibold text-base-900">{nombre}</h3>
          <a href="#" class="text-sm text-base-600 mt-2 inline-block hover:underline">Ver obras →</a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
