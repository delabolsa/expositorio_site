---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allInterviews = await getCollection("interviews");
const sortedInterviews = allInterviews.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="Entrevistas">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4">Entrevistas</h1>
    <p class="text-lg text-gray-600 mb-8">Conocé un poco más a estos artistas, quienes se dejaron entrever en una serie de preguntas, las cuales son: ¿Cómo iniciaste en el arte? ¿Cuál es tu búsqueda haciendo lo que haces? ¿En qué estás trabajando ahora?. </p>
        <p class="text-lg text-gray-800 mb-8"> Visitá el canal en Youtube para ver más. </p>

    {sortedInterviews.length === 0 && (
      <p class="text-center text-gray-500">Próximamente entrevistas.</p>
    )}
    
    {sortedInterviews.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedInterviews.map((interview) => (
          <div class="border border-gray-200 rounded-lg overflow-hidden">
            <div class="h-48 bg-gray-100">
              <img 
                src={interview.data.image.url}
                alt={interview.data.image.alt}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4">
              <h2 class="text-xl font-bold mb-2">
                <a href={`/entrevistas/${interview.id}`}>
                  {interview.data.title}
                </a>
              </h2>
              <p class="text-pink-600 font-semibold mb-2">
                Con: {interview.data.interviewee}
              </p>
              <p class="text-sm text-gray-500 mb-3">
                {new Date(interview.data.pubDate).toLocaleDateString('es-ES')}
              </p>
              <p class="text-gray-700 mb-4">
                {interview.data.description}
              </p>
              <a href={`/entrevistas/${interview.id}`} class="text-pink-600 font-semibold">
                Ver entrevista
              </a>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
