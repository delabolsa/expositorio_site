---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allInterviews = await getCollection("interviews");
const sortedInterviews = allInterviews.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="Entrevistas - Expositorio Voyeur">
  <div class="text-base-950 flex flex-col items-center">
    <section class="w-full py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-4xl font-bold mb-4">Entrevistas</h1>
        <p class="text-lg text-gray-600">Conversaciones, historias y perspectivas</p>
      </div>
    </section>

    <section class="w-full py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        {allInterviews.length === 0 ? (
          <p class="text-center text-gray-500">Próximamente entrevistas.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {sortedInterviews.map((interview) => (
              <article class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition">
                <div class="relative h-48 overflow-hidden bg-gray-100">
                  <img 
                    src={interview.data.image.url} 
                    alt={interview.data.image.alt}
                    class="w-full h-full object-cover"
                  />
                    <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-0">
                    <span class="text-white text-3xl opacity-0 hover:opacity-100">▶</span>
                  </div>
                </div>
                <div class="p-4">
                  <h2 class="text-xl font-bold mb-2">
                    <a href={`/entrevistas/${interview.id}`} class="hover:text-pink-600">
                      {interview.data.title}
                    </a>
                  </h2>
                  <p class="text-pink-600 font-semibold mb-2">Con: {interview.data.interviewee}</p>
                  <p class="text-sm text-gray-500 mb-3">
                    {new Date(interview.data.pubDate).toLocaleDateString('es-ES')}
                  </p>
                  <p class="text-gray-700 mb-4">{interview.data.description}</p>
                  <a href={`/entrevistas/${interview.id}`} class="text-pink-600 font-semibold hover:underline">
                    Ver entrevista →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
