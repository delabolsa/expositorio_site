---
import { getCollection } from "astro:content";
import MarkdownPostLayout from "../../layouts/BlogLayout.astro";

const allInterviews = await getCollection("interviews");
const sortedInterviews = allInterviews.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<MarkdownPostLayout frontmatter={{ title: "Entrevistas", description: "Conversaciones, historias y perspectivas" }}>
  <div class="interviews-container">
    <h1>Entrevistas</h1>
    <p class="subtitle">Conversaciones, historias y perspectivas</p>

    <div class="interviews-grid">
      {sortedInterviews.map((interview) => (
        <article class="interview-card">
          <div class="thumbnail">
            <img src={interview.data.image.url} alt={interview.data.image.alt} />
            <div class="play-button">▶</div>
          </div>
          <div class="interview-content">
            <h2>
              <a href={`/entrevistas/${interview.id}`}>{interview.data.title}</a>
            </h2>
            <p class="interviewee">Con: {interview.data.interviewee}</p>
            <p class="date">{new Date(interview.data.pubDate).toLocaleDateString('es-ES')}</p>
            <p class="description">{interview.data.description}</p>
            <a href={`/entrevistas/${interview.id}`} class="view-interview">Ver entrevista →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</MarkdownPostLayout>

<style>
  .interviews-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .interviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .interview-card {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .interview-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .thumbnail {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.7);
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .interview-card:hover .play-button {
    opacity: 1;
  }

  .interview-content {
    padding: 1.5rem;
  }

  .interview-content h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem 0;
  }

  .interview-content h2 a {
    color: inherit;
    text-decoration: none;
  }

  .interview-content h2 a:hover {
    color: #0066cc;
  }

  .interviewee {
    color: #0066cc;
    font-weight: 500;
    margin: 0.5rem 0;
  }

  .date {
    color: #666;
    font-size: 0.9rem;
    margin: 0.5rem 0;
  }

  .description {
    margin: 1rem 0;
    color: #333;
    line-height: 1.5;
  }

  .view-interview {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }

  .view-interview:hover {
    text-decoration: underline;
  }
</style>---
